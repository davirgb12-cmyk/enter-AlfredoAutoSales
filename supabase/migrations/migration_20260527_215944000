
CREATE TABLE IF NOT EXISTS public.messages (
  id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
  car_id uuid REFERENCES public.cars(id) ON DELETE CASCADE NOT NULL,
  content text NOT NULL CHECK (char_length(content) > 0 AND char_length(content) <= 1000),
  sender_name text NOT NULL DEFAULT 'Visitante',
  sender_type text NOT NULL DEFAULT 'buyer' CHECK (sender_type IN ('buyer', 'seller')),
  user_id uuid REFERENCES auth.users(id) ON DELETE SET NULL,
  created_at timestamptz DEFAULT now() NOT NULL
);

ALTER TABLE public.messages ENABLE ROW LEVEL SECURITY;

-- Anyone can read messages (public chat thread per car)
CREATE POLICY "Public read messages"
  ON public.messages FOR SELECT
  USING (true);

-- Anyone can send buyer messages (no auth required)
CREATE POLICY "Anyone insert buyer message"
  ON public.messages FOR INSERT
  WITH CHECK (sender_type = 'buyer' AND user_id IS NULL);

-- Authenticated sellers can send replies on their own car's thread
CREATE POLICY "Seller insert reply"
  ON public.messages FOR INSERT TO authenticated
  WITH CHECK (
    sender_type = 'seller'
    AND user_id = auth.uid()
    AND EXISTS (
      SELECT 1 FROM public.cars
      WHERE public.cars.id = car_id
        AND public.cars.user_id = auth.uid()
    )
  );

-- Enable realtime
ALTER PUBLICATION supabase_realtime ADD TABLE public.messages;
